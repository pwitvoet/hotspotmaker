<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Images\icon_mirror_h.png" />
    <AvaloniaResource Include="Assets\Images\icon_mirror_hv.png" />
    <AvaloniaResource Include="Assets\Images\icon_mirror_v.png" />
    <AvaloniaResource Include="Assets\Images\icon_rotate.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MLib\MLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Configuration\PresetWindow.axaml.cs">
      <DependentUpon>PresetWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Configuration\SettingsWindow.axaml.cs">
      <DependentUpon>SettingsWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\LabelsTextBox.axaml.cs">
      <DependentUpon>LabelsTextBox.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\MessageBox.axaml.cs">
      <DependentUpon>MessageBox.axaml</DependentUpon>
    </Compile>
    <Compile Update="Editor\HotspotEditorView.axaml.cs">
      <DependentUpon>HotspotEditorView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Hotspot\HotspotProjectView.axaml.cs">
      <DependentUpon>HotspotProjectView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Hotspot\RenameLabelWindow.axaml.cs">
      <DependentUpon>RenameLabelWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
